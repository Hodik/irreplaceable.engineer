  <script is:inline>
    (function () {
      var BASE_PRICE = 49;
      var applied = false;

      function applyDiscount() {
        if (applied) return true;
        var slot = document.getElementById("ppp-banner-slot");
        if (!slot) return false;
        var bolds = slot.querySelectorAll("b");
        if (bolds.length < 2) return false;

        var percentText = (bolds[0].textContent || "").trim();
        var code = (bolds[1].textContent || "").trim();
        var percent = parseInt(percentText, 10);
        if (!code || isNaN(percent) || percent <= 0) return false;

        var discounted = BASE_PRICE * (1 - percent / 100);
        var priceStr = "$" + (Number.isInteger(discounted) ? discounted : discounted.toFixed(2));

        var priceEl = document.getElementById("price-amount");
        if (priceEl) priceEl.textContent = priceStr;

        var pppPercent = document.getElementById("ppp-percent");
        if (pppPercent) pppPercent.textContent = String(percent);

        var pppCode = document.getElementById("ppp-code");
        if (pppCode) pppCode.textContent = code;

        var pppText = document.getElementById("price-ppp-text");
        if (pppText) pppText.textContent = percent + "% off · regional pricing applied";

        document.body.classList.add("ppp-active");

        var cta = document.getElementById("lab-whop-cta");
        if (cta) {
          try {
            var url = new URL(cta.href);
            url.searchParams.delete("promoCode");
            url.searchParams.set("promoCode", code);
            cta.href = url.toString();
          } catch (e) {}
        }

        applied = true;
        if (window.posthog) {
          window.posthog.capture("ppp_discount_applied", { percent: percent, code: code });
        }
        return true;
      }

      if (applyDiscount()) return;

      var slot = document.getElementById("ppp-banner-slot");
      if (!slot) return;

      var obs = new MutationObserver(function () {
        if (applyDiscount()) obs.disconnect();
      });
      obs.observe(slot, { childList: true, subtree: true });

      setTimeout(function () {
        if (!applied && window.posthog) {
          window.posthog.capture("ppp_discount_none");
        }
      }, 8000);
    })();
  </script>
