---
import Layout from "../layouts/Layout.astro";
import founderPhoto from "../assets/me.PNG";
import diagnosticImg from "../assets/screens/diagnostic.png";
import readingMapImg from "../assets/screens/reading-map.png";
import hldQuestionImg from "../assets/screens/hld-question.png";
import feedbackImg from "../assets/screens/feedback.png";
import videoImg from "../assets/screens/video.png";
import discordImg from "../assets/screens/discord.png";
import "../styles/lab-landing.css";

const checkoutUrl = "https://whop.com/checkout/plan_eKxbzNBf6ERFb";

const processSteps = [
  {
    n: "01",
    title: "Diagnose your gaps",
    body: "Before you read a word, a diagnostic surfaces what you actually understand versus what you only think you do. The result shapes your reading map for the book.",
    img: diagnosticImg,
    alt: "Starting assessment — DDIA",
  },
  {
    n: "02",
    rev: true,
    title: "Read the book with a reading map shaped around your gaps",
    bodyHtml:
      "The Lab's current book is <em>Designing Data-Intensive Applications</em>, which takes about three months at a sustainable weekly pace. The reading map tells you which chapters to read deeply, which to skim for context, and which to skip entirely. Each book in the curriculum runs at a similar cadence.",
    img: readingMapImg,
    alt: "Reading map — DDIA Ch 7 Sharding",
  },
];

const practiceStep = {
  n: "03",
  title: "Practice what you read",
  body: "Each week, you complete a handcrafted assessment built for the chapters you just finished: a code review, an HLD, a refactor, or a trade-off scenario. Within seconds, you get feedback against a senior-engineer rubric, and when the topic is dense enough that text alone won't cut it, there's a video explanation waiting.",
};

const discussStep = {
  n: "04",
  title: "Discuss with peers working through the same book",
  body: "Members share what they're noticing in the chapters, including the parts the book got wrong. Weekly threads tied to the chapters you're on, denser with each cohort.",
  img: discordImg,
  alt: "Discord thread — DDIA Ch 2",
};

const capabilities = [
  {
    title: "You design systems end to end",
    body: "You can take an ambiguous problem, choose a shape, name the tradeoffs, and produce a design doc a senior engineer engages with rather than rewrites.",
  },
  {
    title: "You read code architecturally",
    body: "Beyond style and bugs, you see the wrong abstraction, the implicit coupling, the consistency assumption that breaks at scale. Your reviews change PRs, not just polish them.",
  },
  {
    title: "You see refactors that move the product forward",
    body: "You can tell essential complexity from accidental, and you know when a rewrite earns its cost versus when it just rearranges code that already works.",
  },
  {
    title: "You own technical decisions in front of other engineers",
    body: "In design reviews, standups, and 1:1s, you make calls and defend them with reasoning grounded in principles, not pattern-matching.",
  },
];

const pricingFeatures = [
  "Curated, sequenced book curriculum",
  "Knowledge gap diagnostic before each book",
  "Detailed reading maps: what to read deeply, skim, or skip",
  "Handcrafted weekly assessments: code reviews, HLDs, refactoring challenges",
  "Instant AI feedback on every submission, against senior-engineer rubrics",
  "Video explanations on complex topics",
  "Private community of serious backend engineers",
];

const faqItems = [
  {
    q: "What if I'm too busy to keep up with the reading schedule?",
    aHtml:
      "<p>The Lab is built for working engineers. About 30 minutes of reading a day and one assessment a week. The cadence adapts to the book, not the other way around. <em>Designing Data-Intensive Applications</em> runs about three months at a sustainable pace, and if you fall behind a chapter, you pick up where you left off. This isn't a bootcamp.</p>",
  },
  {
    q: "What skill level is this for?",
    aHtml:
      "<p>Mid-level backend engineers with two to five years of experience who want to build the depth and judgment to reach senior and beyond. If you're past the basics but feel the path from where you are to senior is unstructured, this is for you.</p>",
  },
  {
    q: "Is this tied to a specific language or tech stack?",
    aHtml:
      "<p>No. The curriculum is language-agnostic and principle-driven. You'll work on code quality, architectural tradeoffs, data modeling, and engineering fundamentals that apply regardless of whether you write Go, Java, Python, or anything else.</p>",
  },
  {
    q: "What kind of assessments are these?",
    aHtml:
      "<p>You review real code for design flaws, write and critique high-level designs, make refactoring decisions with genuine tradeoffs, and defend your reasoning. The same kind of thinking senior and staff engineers do daily.</p>",
  },
  {
    q: "Is this just ChatGPT critiquing my work?",
    aHtml:
      "<p>No. Each assessment has a handcrafted senior-engineer rubric: the correct answers, the canonical best approaches, and the trade-off frameworks for that specific scenario. The AI evaluates your submission against that rubric, in seconds. It's not generating opinions, it's applying a rubric a senior engineer wrote.</p>",
  },
  {
    q: "How is this different from LeetCode, boot.dev, technical books, or CodeCrafters?",
    aHtml: `
      <p>Each of those is good at something specific:</p>
      <ul>
        <li><strong>LeetCode</strong> is for passing interviews and grinding algorithmic problems</li>
        <li><strong>boot.dev</strong> is for learning a programming language from scratch</li>
        <li><strong>Technical books</strong> are for building deep theoretical understanding</li>
        <li><strong>CodeCrafters</strong> is for re-implementing systems to learn internals</li>
      </ul>
      <p>The Lab is for the gap none of them fills: turning what you read into engineering judgment you can actually defend at work. Reading maps that cut filler, weekly assessments that require real reasoning, AI feedback against senior rubrics, peers working through the same material. The system between knowing things and using them.</p>
    `,
  },
];
---

<Layout>
  <div class="lab-landing">
    <div id="ppp-banner-slot" style="display:none"></div>

    <div class="page">
      <section class="hero">
        <div class="container">
          <div class="ppp-eyebrow" id="ppp-eyebrow">
            <span class="ppp-flag" aria-hidden="true">
              <span class="ppp-flag-blue"></span>
              <span class="ppp-flag-yellow"></span>
            </span>
            <span>
              We've applied a PPP discount of
              <strong class="ppp-emph"><span id="ppp-percent">0</span>% off</strong>.
              Use code <code class="ppp-code" id="ppp-code">CODE</code> at checkout.
            </span>
          </div>

          <h1>
            The path to senior, <span class="accent-underline">structured</span>.
          </h1>
          <p class="hero-sub">
            A book-led system for backend engineers. Read the canonical books,
            complete senior-level assessments, get rubric-graded feedback on
            every submission.
          </p>
          <div class="hero-ctas">
            <a class="btn btn-primary btn-large" href="#pricing" id="lab-whop-cta-top">
              Join the Lab
              <svg class="btn-arrow" viewBox="0 0 16 16" fill="none">
                <path d="M3 8 H13 M9 4 L13 8 L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
            <a class="btn btn-secondary btn-large" href="#how">How it works</a>
          </div>

          <div class="hero-visual-shell">
            <div class="hero-visual">
              <div class="panel">
                <div class="panel-header">
                  <span class="crumbs"><span>Code review</span></span>
                  <span class="meta">DDIA · Ch 7</span>
                </div>
                <div class="panel-title">Find every sharding bug before this ships.</div>
                <div class="code-block code-block-pr"><div class="code-line"><span class="ln">1</span><span><span class="kw">def</span> <span class="fn">shard_for</span>(tenant_id):</span></div><div class="code-line"><span class="ln">2</span><span>    h = hashlib.<span class="fn">md5</span>(tenant_id.<span class="fn">encode</span>())</span></div><div class="code-line code-line-hl3"><span class="ln">3</span><span>    <span class="kw">return</span> nodes[<span class="fn">int</span>(h.<span class="fn">hexdigest</span>(), <span class="num">16</span>) % <span class="fn">len</span>(nodes)]</span></div><div class="pr-comment"><div class="pr-comment-head"><span class="badge badge-muted bug">BUG</span><span class="pr-comment-meta">Comment on line 3</span></div><p class="pr-comment-body">md5 + modulo means adding a node remaps almost everything. Should use consistent hashing.</p></div><div class="code-line"><span class="ln">4</span><span></span></div><div class="code-line"><span class="ln">5</span><span><span class="kw">def</span> <span class="fn">write_event</span>(tenant_id, evt):</span></div><div class="code-line"><span class="ln">6</span><span>    eid = <span class="str">f"&#123;tenant_id&#125;:&#123;evt['name']&#125;:&#123;time.time_ns()&#125;"</span></span></div><div class="code-line"><span class="ln">7</span><span>    <span class="fn">shard_for</span>(tenant_id).<span class="fn">put</span>(eid, evt)</span></div><div class="code-line"><span class="ln">8</span><span class="com">    # also maintain: event_name → [event_ids]</span></div><div class="code-line"><span class="ln">9</span><span>    idx = <span class="fn">shard_for</span>(evt[<span class="str">'name'</span>])</span></div><div class="code-line"><span class="ln">10</span><span>    items = idx.<span class="fn">get</span>(<span class="str">f"idx:&#123;evt['name']&#125;"</span>) <span class="kw">or</span> []</span></div><div class="code-line"><span class="ln">11</span><span>    idx.<span class="fn">put</span>(<span class="str">f"idx:&#123;evt['name']&#125;"</span>, items + [eid])</span></div></div>
              </div>

              <div class="hero-visual-arrow" aria-hidden="true">
                <svg width="26" height="16" viewBox="0 0 26 16" fill="none">
                  <path d="M2 8 L22 8 M17 2 L22 8 L17 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>

              <div class="panel panel-feedback">
                <div class="panel-header">
                  <span class="crumbs"><span>AI feedback · Senior rubric</span></span>
                  <span class="meta">1 of 3 found</span>
                </div>
                <div class="ai-panel-body">
                  <div class="finding finding-crit">
                    <div class="finding-row">
                      <span class="badge badge-solid crit">CRITICAL</span>
                      <span class="chip chip-found">
                        <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                          <path d="M3 8.5 L6.5 12 L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                        FOUND
                      </span>
                    </div>
                    <div class="finding-title">MD5 + modulo: total reshuffle on resize</div>
                    <p class="finding-body">You caught it. A senior would also quantify: ~80% of keys remap going from 4 to 5 nodes.</p>
                    <div class="finding-ref">Ch 7 · Hash Partitioning</div>
                  </div>

                  <div class="finding finding-skew">
                    <div class="finding-row">
                      <span class="badge badge-solid skew">SKEW</span>
                      <span class="chip chip-missed">MISSED</span>
                    </div>
                    <div class="finding-title">Tenant-only key creates hot shards</div>
                    <p class="finding-body">One large tenant overloads its node. Compound the key with event_id.</p>
                    <div class="finding-ref">Ch 7 · Skewed Workloads</div>
                  </div>

                  <div class="finding finding-cross">
                    <div class="finding-row">
                      <span class="badge badge-solid cross">CROSS-SHARD</span>
                      <span class="chip chip-missed">MISSED</span>
                    </div>
                    <div class="finding-title">Index lives on a different node than events</div>
                    <p class="finding-body">Each write hits two nodes with no atomicity. Use a local secondary index.</p>
                    <div class="finding-ref">Ch 7 · Secondary Indexes</div>
                  </div>

                  <div class="findings-footer">+ 1 more finding</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="trust">
        <div class="container">
          <p class="trust-label">Join members from companies like</p>
          <div class="trust-logos">
            <span class="logo-text">Google</span>
            <span class="logo-text" style="font-weight:600; letter-spacing:-0.02em">MongoDB</span>
            <span class="logo-text" style="letter-spacing:-0.02em">Revolut</span>
            <span class="logo-text" style="letter-spacing:-0.02em">EPAM</span>
          </div>
        </div>
      </section>

      <section class="felt-pain">
        <div class="container-narrow">
          <h2>Sound familiar?</h2>
          <ul class="pain-list">
            <li>You've started <span class="em">Designing Data-Intensive Applications</span> twice. You're not sure you'd remember chapter 3 if asked.</li>
            <li>You read technical books passively because you have no way to test whether you actually understood them.</li>
            <li>You make architectural decisions by pattern-matching what you've seen at work, not by reasoning from principles you've internalized.</li>
            <li>You've never had your code review skills, design instincts, or refactor judgment evaluated against a senior-engineer rubric.</li>
            <li>You learn what your current job exposes you to, which is a narrow slice of what senior engineers actually need to know.</li>
          </ul>

          <figure class="testimonial-card">
            <div class="testimonial-head">
              <div class="testimonial-avatar" aria-hidden="true">V</div>
              <div class="testimonial-id">
                <div class="testimonial-name">Vlad</div>
                <div class="testimonial-role">Software Engineer at Google</div>
              </div>
            </div>
            <blockquote class="testimonial-quote">
              "This course was exactly what I needed. It helped me stop giving up on
              hard technical books and finally finish them. The quizzes are excellent
              for checking my understanding and making sure I can actually use the
              theory in real tasks."
            </blockquote>
            <figcaption class="testimonial-source">
              <svg class="discord-glyph" width="18" height="14" viewBox="0 0 24 18" fill="currentColor" aria-hidden="true">
                <path d="M20.317 1.492A19.79 19.79 0 0 0 15.79 0a14.9 14.9 0 0 0-.69 1.42 18.27 18.27 0 0 0-5.487 0A14.9 14.9 0 0 0 8.92 0a19.83 19.83 0 0 0-4.53 1.494C1.063 6.3.16 10.978.61 15.59a19.95 19.95 0 0 0 6.062 3.05c.49-.66.928-1.362 1.305-2.097-.71-.266-1.39-.595-2.04-.985.171-.126.339-.257.5-.39 3.926 1.83 8.18 1.83 12.06 0 .163.135.33.266.5.39-.652.392-1.334.722-2.044.989a14.61 14.61 0 0 0 1.305 2.092 19.86 19.86 0 0 0 6.063-3.052c.527-5.345-.901-9.98-3.999-14.095zM8.02 12.778c-1.183 0-2.157-1.085-2.157-2.42s.955-2.42 2.157-2.42c1.21 0 2.176 1.094 2.157 2.42 0 1.335-.955 2.42-2.157 2.42zm7.974 0c-1.182 0-2.157-1.085-2.157-2.42s.955-2.42 2.157-2.42c1.21 0 2.176 1.094 2.157 2.42 0 1.335-.946 2.42-2.157 2.42z"></path>
              </svg>
              <span>Posted in our community Discord</span>
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="mechanism" id="how">
        <div class="container">
          <div class="mechanism-head">
            <div class="section-label"><span class="num">02</span> · The loop</div>
            <h2 class="section-heading">How the Lab works</h2>
          </div>

          <div class="loop-row">
            <div class="loop-step">
              <div class="loop-num">01</div>
              <div class="loop-name">Diagnose</div>
            </div>
            <div class="loop-arrow-wrap">
              <svg class="loop-arrow" width="140" height="24" viewBox="0 0 140 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 12 C 45 6, 90 18, 130 12 L 121 7 M 130 12 L 121 17"></path>
              </svg>
            </div>
            <div class="loop-step">
              <div class="loop-num">02</div>
              <div class="loop-name">Read</div>
            </div>
            <div class="loop-arrow-wrap">
              <svg class="loop-arrow" width="140" height="24" viewBox="0 0 140 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 12 Q 67 8, 130 12 L 121 7 M 130 12 L 121 17"></path>
              </svg>
            </div>
            <div class="loop-step">
              <div class="loop-num">03</div>
              <div class="loop-name">Practice</div>
            </div>
            <div class="loop-arrow-wrap">
              <svg class="loop-arrow" width="140" height="24" viewBox="0 0 140 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 12 C 45 14, 90 10, 130 12 L 121 7 M 130 12 L 121 17"></path>
              </svg>
            </div>
            <div class="loop-step">
              <div class="loop-num">04</div>
              <div class="loop-name">Discuss</div>
            </div>
          </div>

          <div class="steps">
            {processSteps.map((s) => (
              <div class={`step${s.rev ? " rev" : ""}`}>
                <div class="step-text">
                  <div class="step-num">STEP {s.n}</div>
                  <h3>{s.title}</h3>
                  {s.bodyHtml ? <p set:html={s.bodyHtml} /> : <p>{s.body}</p>}
                </div>
                <div class="step-visual">
                  <figure class="shot">
                    <img src={s.img.src} alt={s.alt} loading="lazy" />
                  </figure>
                </div>
              </div>
            ))}

            <div class="step">
              <div class="step-text">
                <div class="step-num">STEP {practiceStep.n}</div>
                <h3>{practiceStep.title}</h3>
                <p>{practiceStep.body}</p>
              </div>
              <div class="step-visual">
                <div class="practice-stack">
                  <div class="practice-item">
                    <div class="practice-eyebrow">THE ASSESSMENT</div>
                    <figure class="shot">
                      <img src={hldQuestionImg.src} alt="HLD question — wallet ledger" loading="lazy" />
                    </figure>
                  </div>
                  <div class="practice-item">
                    <div class="practice-eyebrow">THE FEEDBACK</div>
                    <figure class="shot">
                      <img src={feedbackImg.src} alt="AI feedback against senior rubric" loading="lazy" />
                    </figure>
                  </div>
                  <div class="practice-item">
                    <div class="practice-eyebrow">THE VIDEO, WHEN NEEDED</div>
                    <figure class="shot shot-video">
                      <img src={videoImg.src} alt="Video explanation: pick the isolation level" loading="lazy" />
                    </figure>
                  </div>
                </div>
              </div>
            </div>

            <div class="step rev">
              <div class="step-text">
                <div class="step-num">STEP {discussStep.n}</div>
                <h3>{discussStep.title}</h3>
                <p>{discussStep.body}</p>
              </div>
              <div class="step-visual">
                <figure class="shot shot-tall">
                  <img src={discussStep.img.src} alt={discussStep.alt} loading="lazy" />
                </figure>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="after">
        <div class="container">
          <div class="section-label"><span class="num">03</span> · The outcome</div>
          <h2 class="section-heading">After your first book</h2>
          <p class="section-sub">Four capabilities that quietly mark the difference between mid-level and senior.</p>

          <div class="after-grid">
            {capabilities.map((c, i) => (
              <div class="cap-card">
                <div class="cap-icon">
                  {i === 0 && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4 H21 V18 H3 Z"></path><path d="M7 9 H17 M7 13 H13"></path></svg>
                  )}
                  {i === 1 && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18 L3 12 L9 6"></path><path d="M15 6 L21 12 L15 18"></path></svg>
                  )}
                  {i === 2 && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12 a9 9 0 1 1 -3.5 -7"></path><path d="M21 4 V12 H13"></path></svg>
                  )}
                  {i === 3 && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"></circle><path d="M5 20 c0 -3.5 3 -6 7 -6 s7 2.5 7 6"></path></svg>
                  )}
                </div>
                <h3 class="cap-title">{c.title}</h3>
                <p class="cap-body">{c.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="founder">
        <div class="container">
          <div class="founder-card">
            <div class="founder-portrait">
              <img src={founderPhoto.src} alt="Denis — Senior Backend Software Engineer" />
            </div>
            <div class="founder-text">
              <div class="founder-eyebrow">BUILT BY</div>
              <h2 class="founder-name">Denis</h2>
              <p class="founder-role">Senior Backend Software Engineer</p>
              <blockquote class="founder-quote">
                "This learning system got me to senior level at 22 y.o."
              </blockquote>
            </div>
          </div>
        </div>
      </section>

      <section class="pricing" id="pricing">
        <div class="container">
          <div class="price-card">
            <div class="price-card-tag">Membership</div>

            <div class="price-block">
              <span class="price-amount strike" id="price-amount-strike">$49</span>
              <span class="price-amount" id="price-amount">$49</span>
              <span class="price-period">/ month</span>
            </div>
            <div class="price-ppp-badge" id="price-ppp-badge">
              <svg width="10" height="10" viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="3"></circle></svg>
              <span id="price-ppp-text">40% off · regional pricing applied</span>
            </div>

            <ul class="price-features">
              {pricingFeatures.map((f) => (
                <li>
                  <span class="check">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                      <path d="M3 8.5 L6.5 12 L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>

            <a class="price-cta" href={checkoutUrl} id="lab-whop-cta">Join now</a>

            <p class="price-cancel">Cancel anytime.</p>
          </div>
        </div>
      </section>

      <section class="faq" id="faq">
        <div class="container-narrow">
          <div class="section-label"><span class="num">05</span> · FAQ</div>
          <h2 class="section-heading">The honest answers</h2>
          <p class="section-sub">If something's not here, ask in the community after you join.</p>

          <div class="faq-list">
            {faqItems.map((it, i) => (
              <div class={`faq-item${i === 0 ? " open" : ""}`}>
                <button class="faq-q" type="button">
                  <span>{it.q}</span>
                  <svg class="faq-icon" viewBox="0 0 16 16" fill="none">
                    <path d="M8 3 V13 M3 8 H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                  </svg>
                </button>
                <div class="faq-a" set:html={it.aHtml}></div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="final">
        <div class="container">
          <h2>Start your <span class="underline">first book</span>.</h2>
          <p class="final-fact">$49/mo. Cancel anytime.</p>
          <a class="btn btn-primary btn-large" href="#pricing">Join now</a>
        </div>
      </section>
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll(".lab-landing .faq-item .faq-q").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = btn.closest(".faq-item");
        if (!item) return;
        item.classList.toggle("open");
      });
    });
  </script>

  <script is:inline>
